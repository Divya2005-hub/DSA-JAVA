package day5;

public class missingnumberinarray {
	int[]arr = {1,2,3,4,5,7};
	int n = arr.length + 1;
	int totalsum = n*(n+1)/2;
	int arraysum = 0;
	for (int num : arr) {
		arraysum += num;
	}
	int missingnumberinarray = totalsum - arraysum;
	{
		System.out.println(" the missing number is: " + missingnumberinarray);
	}
	
	
	
	
	}
	

}
