package array;

public class Diagonalelements {
	public static void main(String[] args) {
		int[][] matrix = {{1,2,3,4},{4,5,6,2},{7,8,9,2}};
		
		int sum = 0;
		
		for(int i = 0; i < matrix.length; i++)
		{
			sum = sum + matrix[i][i];
		}
		System.out.println("sum of diagonal elements is :" +sum);
		
	}


}
